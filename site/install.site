#!/bin/sh
# Runs chroot(8)'d into the freshly-installed target system, after all
# sets (including this site set) have been extracted. See
# install.site(5) and the "Custom File Sets" section of
# https://www.openbsd.org/faq/faq4.html.
#
# Keep this idempotent -- customize as the project grows.

set -e
now=`date '+%Y%m%d%H%M'`
logfile=/var/log/install.site.log
echo "chmod 755 /usr/local/bin/setup_arkgate.sh" >> /etc/rc.firsttime
echo "/usr/local/bin/setup_arkgate.sh" >> /etc/rc.firsttime
echo "cp /usr/local/arkgate_templates/config.json.arkgated /usr/local/arkgate/arkgated/rundir/config.json"  >> /etc/rc.firsttime
echo "sed -i \"s/myname/specz${now}/\" /usr/local/arkgate/arkgated/rundir/config.json"  >> /etc/rc.firsttime
echo "specz${now}" > /etc/myname
echo "install.site: custom provisioning complete" >> $logfile

